# ========== 镜像（可选）==========
# 与 docker/ 下 compose、docker-rmi.bat / docker-build.bat / docker-export.bat 共用
DUID_IMAGE_TAG=1.0.0
# DUID_BASE_IMAGE=eclipse-temurin:21-jre-alpine

# 宿主机日志目录（映射到容器 /home/worker/duid）
DUID_LOG_HOST_DIR=/home/worker/duid

# ========== Redis 连接（必填）==========
# Redis 与 duid 同在 app-net001 网络，用容器名连接（勿用 localhost）
DUID_REDIS_ADDRESS=redis://redis-local2:6379
REDIS_CONTAINER_NAME=redis-local2

# Redis 密码（与 Redis 实际密码一致；无密码留空）
DUID_REDIS_PASSWORD=rds123456

# 多副本数量（仅 docker/docker-compose.multi.yml 使用）
DUID_REPLICAS=3

# ========== 容器内存（初始值偏低，可按机器配置调大）==========
DUID_SERVER_MEM_LIMIT=256m
DUID_SERVER_JAVA_OPTS=-Xms64m -Xmx192m -XX:+UseSerialGC -XX:MaxMetaspaceSize=96m
DUID_LB_MEM_LIMIT=64m

# 单副本开发 Docker（docker/docker-compose.yml）可用更小配置：
# DUID_SERVER_MEM_LIMIT=192m
# DUID_SERVER_JAVA_OPTS=-Xms32m -Xmx128m -XX:+UseSerialGC -XX:MaxMetaspaceSize=64m


# ========== Redis ==========
DUID_REDIS_ADDRESS=redis://redis-local2:6379
REDIS_CONTAINER_NAME=redis-local2
DUID_REDIS_PASSWORD=rds123456

# ========== 副本 / 内存 ==========
DUID_REPLICAS=3
DUID_SERVER_MEM_LIMIT=256m
DUID_SERVER_JAVA_OPTS=-Xms64m -Xmx192m -XX:+UseSerialGC -XX:MaxMetaspaceSize=96m
DUID_LB_MEM_LIMIT=64m

# ========== 镜像 / 日志 ==========
# 宿主机日志目录 -> 容器 /home/worker/duid
DUID_LOG_HOST_DIR=/home/worker/duid
